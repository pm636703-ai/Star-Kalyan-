/* STICKY BUTTON (SMALL & PREMIUM) */
.sticky-bar{
  position:fixed;
  bottom:14px;
  left:50%;
  transform:translateX(-50%);
  width:90%;
  max-width:380px;
  z-index:999;
}
.sticky-inner{
  background:linear-gradient(90deg,#ffd54f,#ff9800);
  border-radius:14px;
  padding:10px 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  box-shadow:0 8px 30px rgba(0,0,0,.5);
}
.sticky-left{
  display:flex;
  align-items:center;
  gap:10px;
  color:#3b001f;
}
.sticky-left img{
  width:34px;
  height:34px;
